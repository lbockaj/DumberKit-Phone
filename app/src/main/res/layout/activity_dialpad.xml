<?xml version="1.0" encoding="utf-8"?>
<!-- Keypad dialing: the typed number on top, the contacts matching it (number or T9 name) below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialpad_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- the number row: a handset on the left, the typed number with a blinking cursor after it -->
    <LinearLayout
        android:id="@+id/dialpad_number_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dpad_dial_number_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin">

        <ImageView
            android:id="@+id/dialpad_number_icon"
            android:layout_width="@dimen/dpad_dial_icon_size"
            android:layout_height="@dimen/dpad_dial_icon_size"
            android:layout_marginEnd="@dimen/activity_margin"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone_vector" />

        <TextView
            android:id="@+id/dialpad_number"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:defaultFocusHighlightEnabled="false"
            android:ellipsize="start"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="@dimen/dpad_dial_number_text_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/dialpad_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/small_margin"
        android:textSize="@dimen/dpad_dial_name_text_size"
        android:visibility="gone" />

    <View
        android:id="@+id/dialpad_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.2" />

    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/dialpad_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

</LinearLayout>
