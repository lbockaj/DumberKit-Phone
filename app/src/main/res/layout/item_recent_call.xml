<?xml version="1.0" encoding="utf-8"?>
<!--
  A call history row. DumberKit: plain nested LinearLayouts instead of Fossify's ConstraintLayout, whose ratio
  constraints measured every row several times (~40 ms a row on a slow keypad phone, the history showed up late).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_recents_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin">

    <ImageView
        android:id="@+id/item_recents_image"
        android:layout_width="@dimen/normal_icon_size"
        android:layout_height="@dimen/normal_icon_size"
        android:layout_marginStart="@dimen/normal_margin"
        android:layout_marginEnd="@dimen/small_margin"
        android:padding="@dimen/small_margin"
        android:src="@drawable/ic_person_vector" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_marginEnd="@dimen/small_margin"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_recents_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="false"
            android:marqueeRepeatLimit="3"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textDirection="firstStrongLtr"
            android:textSize="@dimen/bigger_text_size"
            tools:text="John Doe" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/item_recents_sim_image"
                    android:layout_width="@dimen/dpad_recents_small_icon_size"
                    android:layout_height="@dimen/dpad_recents_small_icon_size"
                    android:alpha="0.6"
                    android:padding="@dimen/tiny_margin"
                    android:src="@drawable/ic_sim_vector"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/item_recents_sim_id"
                    android:layout_width="@dimen/dpad_recents_small_icon_size"
                    android:layout_height="@dimen/dpad_recents_small_icon_size"
                    android:gravity="center"
                    android:textColor="@color/md_grey_black"
                    android:textSize="@dimen/small_text_size"
                    android:visibility="gone"
                    tools:text="1"
                    tools:visibility="visible" />
            </FrameLayout>

            <ImageView
                android:id="@+id/item_recents_type"
                android:layout_width="@dimen/dpad_recents_small_icon_size"
                android:layout_height="@dimen/dpad_recents_small_icon_size"
                android:padding="@dimen/tiny_margin"
                android:src="@drawable/ic_call_missed_vector" />

            <TextView
                android:id="@+id/item_recents_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tiny_margin"
                android:maxLines="1"
                android:textSize="@dimen/normal_text_size"
                tools:text="4 July, 04:37 PM" />

            <TextView
                android:id="@+id/item_recents_date_time_duration_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/small_margin"
                android:alpha="0.6"
                android:maxLines="1"
                android:textSize="@dimen/normal_text_size"
                tools:text="•" />

            <TextView
                android:id="@+id/item_recents_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/small_margin"
                android:alpha="0.6"
                android:maxLines="1"
                android:textSize="@dimen/normal_text_size"
                tools:text="42m 17s" />

            <TextView
                android:id="@+id/item_recents_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/normal_margin"
                android:layout_weight="1"
                android:alpha="0.6"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textSize="@dimen/normal_text_size"
                tools:text="Australia" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/overflow_menu_icon"
            style="@style/OverflowMenuIconStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/overflow_menu_anchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="end|top" />
    </FrameLayout>
</LinearLayout>
